---
import { PortfolioApp, type ViewKey } from "@/components/portfolio/PortfolioApp";
import { fetchPortfolioContent } from "@/lib/server/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  view: ViewKey;
}

const { title, view } = Astro.props;
const initialContent = await fetchPortfolioContent();
---

<BaseLayout title={`Murshida P. | ${title}`}>
  <PortfolioApp client:load initialContent={initialContent} initialView={view} />
</BaseLayout>
