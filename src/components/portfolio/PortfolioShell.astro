---
import ContactActions from "@/components/portfolio/ContactActions";
import { DEFAULT_THEME_INDEX, PORTFOLIO_THEMES, getThemeStyle } from "@/components/portfolio/themeSystem";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { IntroContent } from "@/types/content";

export type PortfolioView = "home" | "about" | "skills" | "projects" | "experience" | "certificates";

interface Props {
  activeView: PortfolioView;
  intro: IntroContent;
  title: string;
}

const { activeView, intro, title } = Astro.props;
const views: Array<{ key: PortfolioView; label: string; href: string }> = [
  { key: "home", label: "Home", href: "/" },
  { key: "about", label: "About Me", href: "/about" },
  { key: "skills", label: "Skills", href: "/skills" },
  { key: "projects", label: "Projects", href: "/projects" },
  { key: "experience", label: "Experience", href: "/experience" },
  { key: "certificates", label: "Certificates", href: "/certifications" }
];
const showFadedRoleBackground = ["home", "about", "experience", "certificates"].includes(activeView);
const showGridBackground = activeView !== "experience";
const fadedPositionClass = activeView === "about" ? "fixed" : "absolute";
const roleWords = intro.role.trim() ? intro.role.trim().split(/\s+/) : ["Web", "Developer"];
const themeStyle = Object.entries(getThemeStyle(PORTFOLIO_THEMES[DEFAULT_THEME_INDEX]))
  .map(([key, value]) => `${key}: ${value}`)
  .join("; ");
---

<BaseLayout title={`Murshida P. | ${title}`}>
  <main class="theme-shell relative min-h-screen overflow-hidden text-zinc-950" style={themeStyle}>
    {showGridBackground ? <div class="theme-hero-grid absolute inset-0"></div> : null}
    <div class="theme-hero-spotlight absolute inset-0 opacity-60"></div>
    <div class="theme-top-glow absolute inset-0 opacity-40"></div>
    {
      showFadedRoleBackground ? (
        <div class:list={["pointer-events-none inset-0 overflow-hidden", fadedPositionClass]}>
          <div class="font-faded-display pointer-events-none absolute left-1/2 top-[12%] z-0 flex w-max -translate-x-1/2 flex-col items-center text-center text-[clamp(6rem,22vw,20rem)] font-black leading-[0.82] tracking-[0.02em] text-zinc-950/[0.035]">
            {roleWords.map((word) => <span class="block text-center">{word.toUpperCase()}</span>)}
          </div>
        </div>
      ) : null
    }

    <div class="relative z-10 mx-auto flex min-h-screen max-w-[1600px] flex-col px-5 pb-8 pt-6 md:px-8 lg:px-10 xl:px-16">
      <header class="relative z-30 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-3 text-zinc-800">
        <nav class="flex flex-wrap items-center justify-start gap-6 md:gap-10" aria-label="Primary navigation">
          {
            views.map((view) => (
              <a
                class:list={[
                  "font-open-sans-light relative pb-1 text-sm font-medium normal-case tracking-normal transition after:absolute after:bottom-0 after:left-0 after:h-px after:bg-current after:transition-[width] after:duration-300 md:text-base",
                  activeView === view.key
                    ? "theme-nav-active after:w-full"
                    : "text-zinc-800 after:w-0 hover:text-zinc-950 hover:after:w-full focus-visible:after:w-full"
                ]}
                href={view.href}
              >
                {view.label}
              </a>
            ))
          }
        </nav>

        <ContactActions client:load intro={intro} />
      </header>

      <slot />
    </div>
  </main>
</BaseLayout>
