---
import AboutSpeechBubble from "@/components/portfolio/AboutSpeechBubble";
import type { IntroContent } from "@/types/content";

interface Props {
  intro: IntroContent;
}

const { intro } = Astro.props;
const introParagraphs = intro.intro.split(/\n\s*\n/).filter(Boolean);
---

<AboutSpeechBubble client:load paragraphs={introParagraphs} />
