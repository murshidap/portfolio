---
import AchievementsIsland from "@/components/portfolio/AchievementsIsland";
import AboutGalleryWheel from "@/components/portfolio/AboutGalleryWheel";
import type { PortfolioContent } from "@/types/content";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
---

<section class="mx-auto min-h-0 w-full max-w-[1600px] flex-1 overflow-y-auto overflow-x-hidden py-10">
  <div class="mx-auto grid w-full max-w-[1180px] grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.78fr)] lg:items-start">
    <div class="pt-2">
      <p class="font-open-sans-light max-w-[46rem] whitespace-pre-line text-justify text-sm font-light leading-6 text-zinc-700">
        {content.intro.intro}
      </p>

      <div class="mt-12">
        <h2 class="font-display text-2xl leading-none text-zinc-950">Education</h2>

        <ul class="mt-6 list-disc space-y-5 pl-5">
          {
            content.education.map((item) => (
              <li class="pl-2">
                <h3 class="text-base font-semibold uppercase leading-tight text-zinc-950">{item.degree}</h3>
                <p class="mt-1 text-sm font-medium uppercase leading-tight text-zinc-800">{item.institution}</p>
                <p class="mt-1 text-sm leading-6 text-zinc-600">{item.duration}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <AboutGalleryWheel client:load items={content.activities} />
    </div>

    <div class="pt-2 lg:pl-12 xl:pl-20">
      <AchievementsIsland client:visible items={content.achievements} />
    </div>
  </div>
</section>
